# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Public URL of your deployed app (no trailing slash)
APP_URL=https://your-app.onrender.com

# PostgreSQL connection string (from Neon / Supabase)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=your_random_32_byte_hex_secret

# Slack incoming webhook URL (from api.slack.com/apps)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Google Gemini API key (from aistudio.google.com) — optional, enables AI triage
GEMINI_API_KEY=your_gemini_api_key

# Node environment
NODE_ENV=production

# Port (Render sets this automatically)
PORT=3000
